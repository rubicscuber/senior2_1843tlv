# Settings for startpi_boot.sh (used by the console_only_pi boot service).
# Copy to startpi_boot.env next to the script and edit; plain VAR=value lines,
# no spaces around '='. Anything left out keeps the script's default.

# Radar ports and chirp configuration
#CFG_FILE=../chirp_configs/IWR_1843BOOST_bike.cfg
#CLI_PORT=/dev/ttyACM0
#DATA_PORT=/dev/ttyACM1

# Safety monitor: uncomment APPROACH_THRESHOLD to enable it
#APPROACH_THRESHOLD=2      # closing speed (m/s) above which the approach-alert LED flashes
#GAP_SECONDS=2             # two-second rule threshold (s); the gap LED lights below it
#WHEEL_DIAMETER=0.7        # wheel diameter (m)
#PULSES_PER_REV=1          # hall-effect pulses per wheel revolution
#PULSE_GPIO=17             # BCM pin of the wheel sensor
#LED_GAP_GPIO=22           # BCM pin of the two-second-rule LED (empty = no LED)
#LED_SPEED_GPIO=23         # BCM pin of the approach-alert LED (empty = no LED)
#CORRIDOR=1.75             # only targets within +/- this lateral distance (m) count for the gap rule
#EXTRA_ARGS=--led-active-low   # any further console_only_Pi options

# Logging
#WAIT_SECS=60
#LOG_MAX_KB=10240
#LOG_KEEP=10
