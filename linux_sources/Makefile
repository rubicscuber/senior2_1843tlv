CXX      ?= g++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra
DEPFLAGS  = -MMD -MP
TARGET    = tm_visualizer
CONSOLE   = console_only
CONSOLEPI = console_only_Pi
WHEELTEST = wheel_test
SRCDIR    = src
BUILDDIR  = build

# Raspberry Pi safety-monitor modules (GPIO, wheel speed, alerts): linked into
# console_only_Pi (and, partly, wheel_test) only
PI_SRCS := $(addprefix $(SRCDIR)/,gpio_line.cpp wheel_speed.cpp safety_monitor.cpp alert_leds.cpp pi_selftest.cpp)
PI_OBJS := $(patsubst $(SRCDIR)/%.cpp,$(BUILDDIR)/%.o,$(PI_SRCS))

# console_only.cpp, console_only_Pi.cpp and wheel_test.cpp have their own
# main(); build them as separate executables
SRCS := $(filter-out $(SRCDIR)/console_only.cpp $(SRCDIR)/console_only_Pi.cpp \
                     $(SRCDIR)/wheel_test.cpp $(PI_SRCS),\
                     $(wildcard $(SRCDIR)/*.cpp))
OBJS := $(patsubst $(SRCDIR)/%.cpp,$(BUILDDIR)/%.o,$(SRCS))
SHARED_OBJS := $(BUILDDIR)/frame_parser.o $(BUILDDIR)/serial_port.o \
               $(BUILDDIR)/cfg_parser.o
CONSOLE_OBJS   := $(BUILDDIR)/console_only.o $(SHARED_OBJS)
CONSOLEPI_OBJS := $(BUILDDIR)/console_only_Pi.o $(SHARED_OBJS) $(PI_OBJS)
WHEELTEST_OBJS := $(BUILDDIR)/wheel_test.o $(BUILDDIR)/gpio_line.o $(BUILDDIR)/wheel_speed.o

.PHONY: all clean selftest

all: $(TARGET) $(CONSOLE) $(CONSOLEPI) $(WHEELTEST)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

$(CONSOLE): $(CONSOLE_OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

$(CONSOLEPI): $(CONSOLEPI_OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

# wheel-speed bench test (no radar needed)
$(WHEELTEST): $(WHEELTEST_OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

$(BUILDDIR)/%.o: $(SRCDIR)/%.cpp | $(BUILDDIR)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c -o $@ $<

$(BUILDDIR):
	mkdir -p $(BUILDDIR)

# built-in logic tests of the safety monitor (no hardware needed)
selftest: $(CONSOLEPI)
	./$(CONSOLEPI) --self-test

clean:
	rm -rf $(BUILDDIR) $(TARGET) $(CONSOLE) $(CONSOLEPI) $(WHEELTEST)

# header dependencies generated by -MMD
-include $(wildcard $(BUILDDIR)/*.d)
